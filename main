import itertools as iter
import time 

Alphabet = ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890-_.")

start = time.time()

counter = 1

Charlength = 1

for CharLength in range(25):
    
    passwords = (itertools.product(Alphabet, repeat = CharLength))
    
print("\n \n")

print("currently working with", CharLength, "chars")
print("i'm currently running this long",(counter / (time.time() - start)), "attemps per seconds :3") 
print("it has been", time.time() - start, " seconds!")
print("I tired so many passwords", counter, "to be exact")

for i in passwords:
    cpimter += 1 
    i = str(i)
    
    i = i.replace("[","")
    i = i.replace("]","")
    i = i.replace("'","")
    i = i.replace(" ","")
    i = i.replace(",","")
    i = i.replace("(","")
    i = i.replace(")","") 
    
    if i == passwords:
        end = time.time()
        timetaken = end - start
        print(f"holy twin found password in", timetaken, "seconds and", counter, "thats like more than 2 attempts")
        print("That is ", counter / timetaken, " attempts per second!")
        print(i)
        input("Press enter when you have finished")
        exit()
    
